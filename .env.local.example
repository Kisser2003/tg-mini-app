NEXT_PUBLIC_APP_URL=https://your-production-domain.example
# Опционально: если с кастомного домена не грузятся /_next/static (Safari, DNS), укажи production *.vercel.app без /
# NEXT_PUBLIC_ASSET_PREFIX=https://your-project.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Telegram ID администратора (числовой). Используется в lib/admin.ts (isAdminUi).
# Источник истины в БД — таблица admin_users (миграция 20260402120000_admin_users_rbac.sql).
# Чтобы добавить/удалить администратора — INSERT/DELETE в admin_users через Supabase Dashboard.
# Сервер: проверка доступа к /api/admin/*.
ADMIN_TELEGRAM_ID=123456789
# Клиент (Next.js): без этого в production вкладка «Админ» не появится — в бандлер попадают только NEXT_PUBLIC_*.
# Должен совпадать с ADMIN_TELEGRAM_ID.
NEXT_PUBLIC_ADMIN_TELEGRAM_ID=123456789
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_token
# Telegram chat id для отправки admin-уведомлений из notify-admin Edge Function и api/notify-admin.
ADMIN_CHAT_ID=123456789

# Подтверждение оплаты студией: на каждый отправленный релиз бот пишет этому человеку
# «Оплатил? [Оплатил] [Не оплатил] [Не мой клиент]». Он должен один раз нажать /start у бота.
PAYMENT_CONFIRMER_TELEGRAM_ID=123456789
# Ник без @ — в сообщении артисту «скинь чек @ник».
PAYMENT_CONFIRMER_USERNAME=studio_username
# Секрет вебхука бота (16+ символов: A-Z a-z 0-9 _ -). Подключение: node --env-file=.env.local scripts/telegram-webhook.mjs --set
TELEGRAM_WEBHOOK_SECRET=replace_with_long_random_string

# Deep-link для кнопки «Открыть админку» в Telegram-уведомлении из Edge Function notify-admin.
# Формат: https://t.me/<bot_username>/app?startapp=admin
# Используется в supabase/functions/notify-admin/index.ts
# Без этой переменной Edge Function использует placeholder и логирует предупреждение.
ADMIN_APP_URL=https://t.me/your_bot_name/app?startapp=admin

# Только development: в `next dev` обход без initData включён по умолчанию (X-Dev-Telegram-User-Id).
# Явно задайте false, чтобы требовать initData / Telegram WebApp:
# NEXT_PUBLIC_ALLOW_DEV_API_AUTH=false
# ALLOW_DEV_API_AUTH=false

# Shared secret for POST /api/webhooks/release-status-change (must match SQL trigger / pg_net headers).
# ОБЯЗАТЕЛЬНО для production: верификация активна по умолчанию; без этой переменной вебхук вернёт 503.
# Задайте тот же секрет в Supabase → Database Webhooks → HTTP Headers: x-supabase-webhook-secret.
SUPABASE_WEBHOOK_SECRET=replace_with_long_random_string

# Google Gemini: автоматическая QA метаданных перед отправкой (submit-precheck / finalize-submit).
# Без GEMINI_API_KEY проверка ИИ пропускается — дальнейшая модерация вручную.
# При 429 / исчерпанной квоте отправка релиза тоже не блокируется (precheck пропускается).
GEMINI_API_KEY=
# Необязательно; по умолчанию gemini-2.0-flash (1.5 на v1beta часто даёт 404).
# GEMINI_METADATA_MODEL=gemini-2.5-flash

# Wallet UI: подставить mock-данные вместо SWR /api/wallet/stats (localhost, без Telegram).
# NEXT_PUBLIC_DEBUG_MOCK_WALLET=1


# --- WAV вне Supabase (обход лимита 50 МБ на файл на бесплатном тарифе) ---
# NEXT_PUBLIC_AUDIO_STORAGE=blob (Vercel Blob, нужен BLOB_READ_WRITE_TOKEN) или s3 (S3_* ниже).
# Любое S3-совместимое хранилище: Backblaze B2, Cloudflare R2, Tigris. См. docs/AUDIO_STORAGE.md.
BLOB_READ_WRITE_TOKEN=
# Если переменные S3_* не заданы, WAV грузятся в Supabase Storage, как раньше.
NEXT_PUBLIC_AUDIO_STORAGE=
NEXT_PUBLIC_MAX_WAV_MB=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Ссылка на мини-приложение для реферальных ссылок (…?startapp=ref_<код>). Без неё в настройках показывается только код.
TELEGRAM_MINI_APP_URL=https://t.me/your_bot/app
